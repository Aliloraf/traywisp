<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A controlled stand-in for an interpreter, used only by TrayWisp.Runtime.Tests. Tests configure it explicitly as
    the interpreter, so the execution engine launches it exactly as it would launch pwsh.exe, python.exe or node.exe.
    It reads instructions from the script file (its last argument) and never runs anything from it. Not shipped.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>TrayWisp.TestHelper</RootNamespace>
  </PropertyGroup>

</Project>
